#!/bin/bash
# {{ ansible_managed }}
# Launch wrapper for the headless Claude Code bot. sudo runs this (see the
# claude-bot sudoers rule) with a reset environment, and every command the bot
# then issues is a non-interactive `bash -c` — which sources neither '.bashrc'
# (its interactive guard returns first) nor '.profile' (read only by login
# shells). So there is no dotfile a headless bot's shells read: the bot's own
# environment is loaded HERE, the one launch point every child process
# inherits. Kept as a separate path from the auto-updated
# '{{ claude_user_home }}/.local/bin/claude' launcher symlink so a bot
# self-update cannot clobber it.

# Tokens for `gh` (GH_TOKEN/GITHUB_TOKEN); already exported in the file, the
# set -a is belt-and-suspenders for future unexported entries.
if [ -f "$HOME/.pat_tokens" ]; then
  set -a
  . "$HOME/.pat_tokens"
  set +a
fi

# X clipboard access for paste. sudo's env_reset drops DISPLAY/XAUTHORITY, and
# the bot's own uid cannot read the human's Xwayland cookie in its 0700 runtime
# dir — so paste reads an empty clipboard. The autostart hook copies that cookie
# to an ACL-readable file; point XAUTHORITY at it here. Skipped when the copy is
# absent (no graphical login yet), leaving paste to fall back to ~/Screenshots.
if [ -r "{{ claude_user_xauth_file }}" ]; then
  export DISPLAY="{{ claude_user_display }}"
  export XAUTHORITY="{{ claude_user_xauth_file }}"
fi

# Rootless Podman needs a runtime dir. Linger (see the claude_user role) keeps a
# persistent /run/user/<uid> for the bot with no login session; point
# XDG_RUNTIME_DIR at it when present so Podman uses it over a churny /tmp fallback.
if [ -d "/run/user/$(id -u)" ]; then
  export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

# sudo's secure_path leaves ~/.local/bin off PATH; the bot's own tools live
# there — including the 'docker' -> podman shim. Idempotent so re-entrant shells
# don't stack duplicates.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

exec "$HOME/.local/bin/claude" "$@"
